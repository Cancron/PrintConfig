{
    "name": "printconfig-api",
    "description": "PrintConfig API with Cloudflare R2 storage.",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "npm --prefix frontend run build && tsc -p tsconfig.json",
        "frontend:dev": "npm --prefix frontend run dev",
        "frontend:typecheck": "npm --prefix frontend run typecheck",
        "frontend:lint": "npm --prefix frontend run lint",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "npm run test:backend && npm run test:frontend",
        "test:backend": "node --import tsx --test tests/backend/*.test.ts",
        "test:frontend": "node --import tsx --test tests/frontend/*.test.ts",
        "db:migrate": "node dist/scripts/migratePostgres.js",
        "db:migrate:dev": "tsx src/scripts/migratePostgres.ts",
        "db:migrate:test": "tsx src/scripts/migratePostgres.ts --test",
        "db:check": "node dist/scripts/checkPostgres.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1156.0",
        "@aws-sdk/s3-request-presigner": "3.1156.0",
        "@napi-rs/canvas": "1.0.13",
        "@supabase/supabase-js": "2.109.0",
        "@types/sanitize-html": "2.16.2",
        "archiver": "8.0.0",
        "bcryptjs": "3.0.3",
        "cors": "2.8.6",
        "dotenv": "16.6.1",
        "express": "4.22.3",
        "jsonwebtoken": "9.0.3",
        "multer": "2.5.0",
        "pg": "8.23.1",
        "sanitize-html": "2.17.5"
    },
    "devDependencies": {
        "@types/archiver": "8.0.0",
        "@types/bcryptjs": "2.4.6",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.3.0",
        "@types/node": "22.20.5",
        "@types/pg": "8.23.1",
        "tsx": "4.23.15",
        "typescript": "5.9.3"
    },
    "overrides": {
        "follow-redirects": "1.15.11"
    }
}
