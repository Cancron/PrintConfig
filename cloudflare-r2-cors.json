{
  "rules": [
    {
      "id": "public-read",
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    },
    {
      "id": "admin-presigned-upload",
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["PUT", "HEAD"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
