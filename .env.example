PORT=5000
# Set to your application prefix when the hosting proxy forwards it to Express.
API_BASE_PATH=
# Optional absolute path to the frontend build; defaults to frontend/dist.
ADMIN_STATIC_DIR="frontend/dist"
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection strings; use separate databases for app and tests.
DATABASE_URL=postgresql://user:password@localhost:5432/printconfig
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/printconfig_test

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_TOKEN=
CLOUDFLARE_PUBLIC_DEV_URL=
CLOUDFLARE_R2_BUCKET=printconfig
R2_SIGNED_UPLOAD_TTL_SECONDS=900

JWT_SECRET=
