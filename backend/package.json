{
    "name": "kodaprints-product-config-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "import:mediaclip-collages": "tsx src/scripts/importMediaclipCollages.ts",
        "migrate:shared-rooms": "tsx src/scripts/migrateSharedRooms.ts",
        "migrate:shared-rooms:apply": "tsx src/scripts/migrateSharedRooms.ts --apply"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.57.4",
        "@types/sanitize-html": "^2.16.1",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.9.5",
        "multer": "^2.2.0",
        "sanitize-html": "^2.17.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.10.7",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
