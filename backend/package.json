{
    "name":  "kodaprints-product-config-backend",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "migrate:shared-rooms":  "tsx src/scripts/migrateSharedRooms.ts",
                    "migrate:shared-rooms:apply":  "tsx src/scripts/migrateSharedRooms.ts --apply"
                },
    "dependencies":  {
                         "@supabase/supabase-js":  "^2.57.4",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.7",
                         "express":  "^4.21.2",
                         "mongoose":  "^8.9.5"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^5.0.0",
                            "@types/node":  "^22.10.7",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.7.3"
                        }
}
