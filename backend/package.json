{
    "name": "printconfig-api",
    "description": "PrintConfig API with Cloudflare R2 storage.",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:mongo": "node scripts/testMongo.mjs",
        "test:mongo-network": "node scripts/testMongoNetwork.mjs",
        "import:mediaclip-collages": "tsx src/scripts/importMediaclipCollages.ts",
        "migrate:shared-rooms": "tsx src/scripts/migrateSharedRooms.ts",
        "migrate:shared-rooms:apply": "tsx src/scripts/migrateSharedRooms.ts --apply",
        "migrate:supabase-to-r2": "tsx src/scripts/migrateSupabaseToR2.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.1156.0",
        "@aws-sdk/s3-request-presigner": "3.1156.0",
        "@napi-rs/canvas": "1.0.13",
        "@supabase/supabase-js": "2.109.0",
        "@types/sanitize-html": "2.16.2",
        "archiver": "8.0.0",
        "bcryptjs": "3.0.3",
        "cors": "2.8.6",
        "dotenv": "16.6.1",
        "express": "4.22.3",
        "jsonwebtoken": "9.0.3",
        "mongoose": "8.24.7",
        "multer": "2.5.0",
        "sanitize-html": "2.17.5"
    },
    "devDependencies": {
        "@types/archiver": "8.0.0",
        "@types/bcryptjs": "2.4.6",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/multer": "2.3.0",
        "@types/node": "22.20.5",
        "tsx": "4.23.15",
        "typescript": "5.9.3"
    },
    "overrides": {
        "follow-redirects": "1.15.11"
    }
}
